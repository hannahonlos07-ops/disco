# ============================================================
#  Discord out-of-office auto-reply bot — settings
# ============================================================

# Your Discord bot token (same one you already use).
DISCORD_BOT_TOKEN=

# The auto-reply message sent to people who post in a support channel
# while you're out of office. One message, used in every server.
OOO_MESSAGE=Thanks for reaching out! Our team is currently out of office. We'll get back to you as soon as we're back during business hours.

# When to auto-reply (what counts as "someone asking us"):
#   mention  = only when your bot is @mentioned (least spammy)
#   channels = any message in a support channel (see below)
#   all      = any message in any channel (most aggressive)
#   both     = mention OR support channel (recommended default)
OOO_TRIGGER=both

# --- Which channels to watch (used by 'channels' and 'both') ---
# Match support channels by NAME (case-insensitive, comma-separated). The bot
# replies in any channel whose name matches one of these across all servers.
OOO_SUPPORT_CHANNELS=support
# Optional: exact channel IDs to watch too (comma-separated). Leave blank to
# just use names above.
OOO_SUPPORT_CHANNEL_IDS=

# --- Business hours (auto-reply fires OUTSIDE these) ---
OOO_TIMEZONE=America/New_York
OOO_BUSINESS_DAYS=1-5        # 1=Mon 2=Tue 3=Wed 4=Thu 5=Fri 6=Sat 7=Sun
OOO_START_HOUR=9             # 9  = 9:00 AM
OOO_END_HOUR=18             # 18 = 6:00 PM

# Don't reply to the same person in the same channel more than once per this
# many minutes (prevents spamming someone who sends several messages).
OOO_COOLDOWN_MINUTES=240
